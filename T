Owner = 1007
```

You don't need to give the **customer's `lu-1007` account** the ownership-changing permission. Create a **technical SFTP local user** specifically for this automation.

## C# code for your requirement

I would use SSH.NET and perform the SFTP `chown` directly.

```csharp
using Renci.SshNet;
using System;

public static class SftpOwnerService
{
    public static void ChangeOwner(
        string storageAccountName,
        string automationUser,
        string automationPassword,
        string filePath,
        uint targetUserId)
    {
        var host = $"{storageAccountName}.blob.core.windows.net";

        using (var sftp = new SftpClient(
            host,
            22,
            automationUser,
            automationPassword))
        {
            sftp.Connect();

            if (!sftp.Exists(filePath))
            {
                throw new InvalidOperationException(
                    $"File does not exist: {filePath}");
            }

            // Read current attributes
            var attributes = sftp.GetAttributes(filePath);

            var oldOwner = attributes.UserId;
            var oldGroup = attributes.GroupId;

            // Change ONLY the owner.
            attributes.UserId = targetUserId;

            // Preserve existing group.
            attributes.GroupId = oldGroup;

            sftp.SetAttributes(filePath, attributes);

            // Verify
            var updatedAttributes =
                sftp.GetAttributes(filePath);

            if (updatedAttributes.UserId != targetUserId)
            {
                throw new InvalidOperationException(
                    $"Unable to change owner for '{filePath}'. " +
                    $"Expected owner '{targetUserId}', " +
                    $"actual owner '{updatedAttributes.UserId}'.");
            }

            sftp.Disconnect();
        }
    }
}
```

