using System;
using System.IO;
using System.Text;
using System.Text.RegularExpressions;
using System.Threading;
using System.Threading.Tasks;

using Azure.Identity;
using Azure.Security.KeyVault.Secrets;
using Azure.Storage.Blobs;
using Azure.Storage.Blobs.Models;

using Renci.SshNet;
using Renci.SshNet.Sftp;

public async Task ProcessOutboundFilesAsync()
{
    // =========================================================
    // EXISTING SERVICE PRINCIPAL CONFIGURATION
    // =========================================================

    var tenantId = _config["AzureSFTPTest-TenID"];

    var clientId = _config["kv-AzureSFTPTest-Username"];

    var clientSecret = _config["kv-AzureSFTPTest-Secret"];

    _logger.LogInformation(
        "Configuration tenantId:{tenantId}, clientId:{clientId}",
        tenantId,
        clientId);

    var credential =
        new ClientSecretCredential(
            tenantId,
            clientId,
            clientSecret);

    // =========================================================
    // EXISTING BLOB CONFIGURATION
    // =========================================================

    string storageAccount = "sthhcsftptest";

    var blobServiceUri =
        new Uri(
            $"https://{storageAccount}.blob.core.windows.net");

    var blobServiceClient =
        new BlobServiceClient(
            blobServiceUri,
            credential);

    var containerClient =
        blobServiceClient.GetBlobContainerClient(
            "sftp-ingest-test");

    string sourceFolder =
        "CleanDocuments/Outbound/";

    // =========================================================
    // SFTP CONFIGURATION
    // =========================================================

    string sftpHost =
        _config["AzureSFTP-Host"];

    string sftpUsername =
        _config["AzureSFTP-OwnerUsername"];

    string keyVaultUri =
        _config["AzureSFTP-KeyVaultUri"];

    string privateKeySecretName =
        _config["AzureSFTP-PrivateKey"];

    // =========================================================
    // GET SFTP PRIVATE KEY FROM KEY VAULT
    // =========================================================

    var keyVaultClient =
        new SecretClient(
            new Uri(keyVaultUri),
            credential);

    KeyVaultSecret privateKeySecret =
        await keyVaultClient.GetSecretAsync(
            privateKeySecretName);

    string privateKey =
        privateKeySecret.Value;

    if (string.IsNullOrWhiteSpace(privateKey))
    {
        throw new InvalidOperationException(
            "SFTP private key was not found in Key Vault.");
    }

    // =========================================================
    // CREATE SSH PRIVATE KEY
    // =========================================================

    using var keyStream =
        new MemoryStream(
            Encoding.UTF8.GetBytes(privateKey));

    var privateKeyFile =
        new PrivateKeyFile(keyStream);

    var authenticationMethod =
        new PrivateKeyAuthenticationMethod(
            sftpUsername,
            privateKeyFile);

    var connectionInfo =
        new ConnectionInfo(
            sftpHost,
            22,
            sftpUsername,
            authenticationMethod);

    // =========================================================
    // CREATE ONE SFTP CONNECTION
    //
    // Important:
    // Do NOT connect/disconnect for every file.
    // Reuse this connection for all files in this batch.
    // =========================================================

    using var sftp =
        new SftpClient(connectionInfo);

    try
    {
        sftp.Connect();

        _logger.LogInformation(
            "Connected to Azure SFTP as {Username}",
            sftpUsername);

        // =====================================================
        // PROCESS FILES
        // =====================================================

        await foreach (
            BlobItem blobItem in
            containerClient.GetBlobsAsync(
                BlobTraits.None,
                BlobStates.None,
                sourceFolder,
                CancellationToken.None))
        {
            var sourceBlobName =
                blobItem.Name;

            // Ignore virtual folders
            if (sourceBlobName.EndsWith("/"))
            {
                continue;
            }

            string fileName =
                Path.GetFileName(sourceBlobName);

            // =================================================
            // GET SUBMITTER ID FROM FILE NAME
            // =================================================

            Match match =
                Regex.Match(
                    fileName,
                    @"^\d{9}");

            if (!match.Success)
            {
                _logger.LogWarning(
                    "Unable to determine submitter ID from file {FileName}",
                    fileName);

                continue;
            }

            string submitterId =
                match.Value;

            // =================================================
            // BUILD USER FOLDER PATH
            // =================================================

            string folderPath =
                $"{submitterId.Substring(0, 2)}/" +
                $"{submitterId.Substring(2, 2)}/" +
                $"{submitterId.Substring(4, 2)}/" +
                $"{submitterId.Substring(6, 3)}/" +
                submitterId;

            string destinationPath =
                $"userhome/{folderPath}/download/batch/";

            string destinationBlobName =
                $"{destinationPath}{fileName}";

            _logger.LogInformation(
                "Copying {Source} to {Destination}",
                fileName,
                destinationBlobName);

            // =================================================
            // SOURCE / DESTINATION BLOB
            // =================================================

            BlobClient sourceBlob =
                containerClient.GetBlobClient(
                    sourceBlobName);

            BlobClient destinationBlob =
                containerClient.GetBlobClient(
                    destinationBlobName);

            // =================================================
            // CHECK IF DESTINATION ALREADY EXISTS
            // =================================================

            if (await destinationBlob.ExistsAsync())
            {
                _logger.LogWarning(
                    "Destination already exists: {Destination}",
                    destinationBlobName);

                continue;
            }

            // =================================================
            // COPY PRIVATE -> PUBLIC
            // =================================================

            var copyOperation =
                await destinationBlob.StartCopyFromUriAsync(
                    sourceBlob.Uri);

            await copyOperation.WaitForCompletionAsync();

            _logger.LogInformation(
                "Blob copied successfully to: {Destination}",
                destinationBlobName);

            // =================================================
            // GET SUBMITTER'S AZURE SFTP USER ID
            // =================================================

            string submitterSftpUserId =
                await GetSftpUserIdAsync(
                    submitterId);

            if (!int.TryParse(
                    submitterSftpUserId,
                    out int userId))
            {
                _logger.LogError(
                    "Invalid SFTP UserId {UserId} for submitter {SubmitterId}. " +
                    "Source file will not be deleted.",
                    submitterSftpUserId,
                    submitterId);

                continue;
            }

            // =================================================
            // CHANGE FILE OWNER
            // =================================================

            string sftpDestinationPath =
                "/" + destinationBlobName;

            try
            {
                ChangeOwner(
                    sftp,
                    sftpDestinationPath,
                    userId);

                _logger.LogInformation(
                    "Owner changed successfully. " +
                    "File:{FileName}, Submitter:{SubmitterId}, UserId:{UserId}",
                    fileName,
                    submitterId,
                    userId);
            }
            catch (Exception ex)
            {
                _logger.LogError(
                    ex,
                    "Failed to change owner for {FileName}. " +
                    "Source file will NOT be deleted.",
                    fileName);

                continue;
            }

            // =================================================
            // VERIFY OWNER
            // =================================================

            try
            {
                var attributes =
                    sftp.GetAttributes(
                        sftpDestinationPath);

                _logger.LogInformation(
                    "Owner verification. File:{FileName}, " +
                    "Expected:{ExpectedUserId}, Actual:{ActualUserId}",
                    fileName,
                    userId,
                    attributes.UserId);

                if (attributes.UserId != userId)
                {
                    _logger.LogError(
                        "Owner verification failed for {FileName}. " +
                        "Expected:{ExpectedUserId}, Actual:{ActualUserId}. " +
                        "Source file will NOT be deleted.",
                        fileName,
                        userId,
                        attributes.UserId);

                    continue;
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(
                    ex,
                    "Unable to verify owner for {FileName}. " +
                    "Source file will NOT be deleted.",
                    fileName);

                continue;
            }

            // =================================================
            // DELETE SOURCE ONLY AFTER SUCCESS
            //
            // Copy succeeded
            // Owner changed
            // Owner verified
            // =================================================

            await sourceBlob.DeleteIfExistsAsync();

            _logger.LogInformation(
                "Source Blob deleted successfully: {Source}",
                fileName);
        }
    }
    finally
    {
        if (sftp.IsConnected)
        {
            sftp.Disconnect();

            _logger.LogInformation(
                "Disconnected from Azure SFTP.");
        }
    }
}


// =============================================================
// CHANGE OWNER USING SSH.NET
// =============================================================

private void ChangeOwner(
    SftpClient sftp,
    string sftpDestinationPath,
    int userId)
{
    if (!sftp.IsConnected)
    {
        throw new InvalidOperationException(
            "SFTP client is not connected.");
    }

    // Get the existing attributes.
    var attributes =
        sftp.GetAttributes(
            sftpDestinationPath);

    int oldUserId =
        attributes.UserId;

    int oldGroupId =
        attributes.GroupId;

    _logger.LogInformation(
        "Changing owner for {File}. " +
        "OldUserId:{OldUserId}, NewUserId:{NewUserId}, GroupId:{GroupId}",
        sftpDestinationPath,
        oldUserId,
        userId,
        oldGroupId);

    // Change ONLY the owner.
    attributes.UserId =
        userId;

    // Keep the existing group.
    attributes.GroupId =
        oldGroupId;

    // Send SETSTAT request through SFTP.
    sftp.SetAttributes(
        sftpDestinationPath,
        attributes);
}


